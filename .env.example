# gestjobs environment template
# Copy this file to .env.local and fill in real values. .env.local is gitignored.

# --- Application ---
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Supabase (https://supabase.com/dashboard → Project Settings → API) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...your-anon-key
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...your-service-role-key

# --- Resend (https://resend.com/api-keys) ---
# Used in PR 5 by /api/cron/reminders. Listed here so the template is complete.
RESEND_API_KEY=re_xxx_your_resend_key
RESEND_FROM_EMAIL=GestJobs <noreply@your-domain.com>
RESEND_REPLY_TO=you@example.com

# --- Cron shared secret ---
# Required header for POST /api/cron/reminders. Generate with: openssl rand -hex 32
CRON_SECRET=replace-with-a-long-random-string
