# gestjobs environment template
# Copy this file to .env.local and fill in real values. .env.local is gitignored.

# --- Application ---
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Supabase (https://supabase.com/dashboard -> Project Settings -> API Keys) ---
SUPABASE_PROJECT_REF=your-project-ref
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# "Publishable key" (public, safe in the browser).
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-publishable-key
# "Secret key" (server only; bypasses RLS). Used by /api/cron/reminders.
SUPABASE_SECRET_KEY=sb_secret_your-secret-key
# Legacy JWT keys (Project Settings -> API Keys -> Legacy API Keys). Only read
# when the new keys above are not set; leave empty on new projects.
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# --- Resend (https://resend.com/api-keys) ---
# Used in PR 5 by /api/cron/reminders. Listed here so the template is complete.
RESEND_API_KEY=re_xxx_your_resend_key
RESEND_FROM_EMAIL=GestJobs <noreply@your-domain.com>
RESEND_REPLY_TO=you@example.com

# --- Cron shared secret ---
# Required header for POST /api/cron/reminders. Generate with: openssl rand -hex 32
CRON_SECRET=replace-with-a-long-random-string
